# Vorlage: nach .env kopieren und ausfuellen. Die .env selbst gehoert nicht ins Git.
# Erzeugen: openssl rand -base64 48

# --- Datenbank ---
MYSQL_DATABASE=wantool
MYSQL_USER=wantool
MYSQL_PASSWORD=

# --- Sitzung und Anmeldung ---
# Mindestens 32 Zeichen. Bei Aenderung werden alle Sitzungen ungueltig.
SESSION_SECRET=
# false nur fuer lokale Tests ohne TLS
COOKIE_SECURE=true
SESSION_LEERLAUF_MINUTEN=20
SESSION_MAXIMAL_MINUTEN=480
PASSWORT_MINDESTLAENGE=12
MAX_FEHLVERSUCHE=5
SPERRDAUER_MINUTEN=15

# --- Betrieb ---
BEHOERDE=Kreis Musterland
UMGEBUNG=produktion
# Kommaliste der zulaessigen Host-Header, z.B. wan-tool.intern.musterland.de
ERLAUBTE_HOSTS=*
# Swagger-Oberflaeche; im Produktionsbetrieb aus
DOCS_AKTIV=false
APP_PORT=8000
# Nur aktivieren, wenn ein vertrauenswuerdiger Reverse Proxy davorsteht
VERTRAUE_PROXY_HEADER=false

# --- Ersteinrichtung (nur beim allerersten Start ausgewertet) ---
START_MANDANT_NAME=Musterland
START_MANDANT_KENNZEICHEN=KR-ML
# Amt | Gemeinde | Stadt | Kreis | Zweckverband | Sonstige
START_MANDANT_ART=Kreis
ADMIN_BENUTZER=admin
ADMIN_PASSWORT=
